PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
DEMO_INVESTOR_STARTING_BALANCE=500000

# Supabase Database Configuration:
# Get your Connection String from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI / Transaction Pooler)
SUPABASE_DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional Supabase SDK API Keys (Project Settings -> API)
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
